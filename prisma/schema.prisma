generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  email     String   @unique
  password  String
  role      Role     @default(EMPLOYEE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id             String       @id @default(cuid()) @map("_id")
  name           String
  email          String       @unique
  password       String
  phone          String?
  whatsapp       String?
  avatar         String?
  department     Department   @default(SALES)
  role           EmployeeRole @default(EMPLOYEE)
  designation    String?
  employeeCode   String?      @unique
  assignedAreas  String?
  joiningDate    DateTime?
  reportingToId  String?
  address        String?
  emergencyName  String?
  emergencyPhone String?
  isActive       Boolean      @default(true)
  lastLogin      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reportingTo Employee?  @relation("EmployeeManager", fields: [reportingToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  team        Employee[] @relation("EmployeeManager")

  leads          Lead[]
  followups      FollowUp[]
  meetings       Meeting[]
  orders         Order[]
  tasks          Task[]
  notifications  Notification[]
  uploadedMedia  LeadMedia[]
  callRecordings CallRecording[]
}

model Lead {
  id              String    @id @default(cuid()) @map("_id")
  customer_name   String
  phone_number    String    @unique
  email           String?
  city            String?
  area            String?
  pincode         String?
  location_detail String?
  meta_lead_id    String?
  ad_id           String?
  created_time    DateTime?
  timeline        String?
  lead_status     String    @default("CREATED")
  stage           LeadStage @default(NEW)
  priority        String?   @default("NORMAL")
  tags            String?
  remarks         String?
  bhkType         String?
  carpetArea      String?
  estimatedBudget String?
  assignedToId    String?
  nextFollowUp    DateTime?
  siteVisitDate   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assignedTo     Employee?       @relation(fields: [assignedToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  activities     Activity[]
  callRecordings CallRecording[]
  followups      FollowUp[]
  media          LeadMedia[]
  meetings       Meeting[]
  orders         Order[]
  tasks          Task[]
}

model Activity {
  id          String   @id @default(cuid()) @map("_id")
  leadId      String
  type        String
  oldStatus   String?
  newStatus   String?
  note        String?
  performedBy String?
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model FollowUp {
  id           String         @id @default(cuid()) @map("_id")
  followupDate DateTime
  remarks      String?
  status       FollowUpStatus @default(PENDING)
  reminderSent Boolean        @default(false)
  leadId       String
  employeeId   String
  createdAt    DateTime       @default(now())
  employee     Employee       @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lead         Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Meeting {
  id            String        @id @default(cuid()) @map("_id")
  meetingDate   DateTime
  notes         String?
  status        MeetingStatus @default(SCHEDULED)
  googleEventId String?
  duration      Int?          @default(30)
  leadId        String
  employeeId    String
  createdAt     DateTime      @default(now())
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lead          Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Order {
  id         String      @id @default(cuid()) @map("_id")
  amount     Float?
  status     OrderStatus @default(PENDING)
  remarks    String?
  leadId     String
  employeeId String
  createdAt  DateTime    @default(now())
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String           @id @default(cuid()) @map("_id")
  title      String
  message    String
  isRead     Boolean          @default(false)
  type       NotificationType @default(INFO)
  employeeId String?
  createdAt  DateTime         @default(now())
  employee   Employee?        @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Task {
  id            String     @id @default(cuid()) @map("_id")
  title         String
  description   String?
  type          TaskType
  status        TaskStatus @default(PENDING)
  leadId        String
  employeeId    String
  scheduledAt   DateTime
  googleEventId String?
  acceptedAt    DateTime?
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  employee      Employee   @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lead          Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadMedia {
  id           String        @id @default(cuid()) @map("_id")
  leadId       String
  uploadedById String?
  type         LeadMediaType
  fileName     String
  fileUrl      String
  fileSize     Int?
  caption      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  uploadedBy   Employee?     @relation(fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model CallRecording {
  id           String        @id @default(cuid()) @map("_id")
  leadId       String
  employeeId   String?
  phoneNumber  String
  direction    CallDirection
  duration     Int           @default(0)
  recordingUrl String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  employee     Employee?     @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

enum CallDirection {
  INCOMING
  OUTGOING
  MISSED
  REJECTED
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum LeadStage {
  NEW
  CALL_SCHEDULED
  FOLLOWUP
  MEETING_FIXED
  SITE_VISIT
  ESTIMATE_SENT
  DESIGN_PHASE
  QUOTATION_APPROVED
  CONFIRMED
  REJECTED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum TaskType {
  CALL
  FOLLOWUP
  MEETING
  SITE_VISIT
}

enum TaskStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum LeadMediaType {
  PHOTO
  VIDEO
  AUDIO
  DOCUMENT
}

enum Department {
  MANAGEMENT
  SALES
  DESIGN
  HR
  ACCOUNTS
  SUPPORT
  MARKETING
  IT
}

enum EmployeeRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SALES_MANAGER
  SALES_EXECUTIVE
  DESIGN_MANAGER
  DESIGNER
  HR_MANAGER
  HR_EXECUTIVE
  ACCOUNT_MANAGER
  ACCOUNT_EXECUTIVE
  SUPPORT
  EMPLOYEE
}
